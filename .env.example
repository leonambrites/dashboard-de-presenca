# Vercel Postgres Connection Variables
# (Estas variáveis são injetadas automaticamente ao vincular um Vercel Postgres / Neon DB no Vercel)

POSTGRES_URL="postgres://default:password@ep-example.us-east-1.aws.neon.tech/verceldb?sslmode=require"
POSTGRES_PRISMA_URL="postgres://default:password@ep-example.us-east-1.aws.neon.tech/verceldb?connect_timeout=15&sslmode=require"
POSTGRES_URL_NON_POOLING="postgres://default:password@ep-example.us-east-1.aws.neon.tech/verceldb?sslmode=require"
POSTGRES_USER="default"
POSTGRES_HOST="ep-example.us-east-1.aws.neon.tech"
POSTGRES_PASSWORD="password"
POSTGRES_DATABASE="verceldb"

# Gemini API Key (Opcional para IA)
GEMINI_API_KEY=""
